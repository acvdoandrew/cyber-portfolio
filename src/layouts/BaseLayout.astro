---
import '../styles/editorial.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Andrew — programmer building strange systems',
  description = 'Andrew’s corner of the web. Rust, C++, Python, small experiments, and things still in progress.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og.png', Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrew',
  url: 'https://www.aceandrew.com/',
  sameAs: [
    'https://github.com/acvdoandrew',
    'https://x.com/etobyte',
  ],
  homeLocation: {
    '@type': 'Place',
    name: 'Boston / Cambridge, Massachusetts',
  },
  knowsAbout: [
    'Rust',
    'Distributed systems',
    'AI infrastructure',
    'Security research',
    'C++',
    'TypeScript',
  ],
};
---
<!doctype html>
<html lang="en" data-palette="archive" data-display-filter="off">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F2F3EE" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <meta name="author" content="Andrew" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/IBMPlexMono-Regular-Latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andrew / Strange Systems" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@etobyte" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      (() => {
        const palettes = {
          archive: { paper: '#F2F3EE', scheme: 'light' },
          carbon: { paper: '#090A09', scheme: 'dark' },
          signal: { paper: '#050806', scheme: 'dark' },
          radiant: { paper: '#0B0905', scheme: 'dark' },
          field: { paper: '#061008', scheme: 'dark' },
          alloy: { paper: '#B4BCC1', scheme: 'light' },
        };
        try {
          const stored = localStorage.getItem('portfolio.palette.v1');
          const id = stored && Object.hasOwn(palettes, stored) ? stored : 'archive';
          const displayFilter =
            localStorage.getItem('portfolio.display-filter.v1') === 'on'
              ? 'on'
              : 'off';
          const palette = palettes[id];
          document.documentElement.dataset.palette = id;
          document.documentElement.dataset.displayFilter = displayFilter;
          document.documentElement.style.colorScheme = palette.scheme;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', palette.paper);
          document
            .querySelector('meta[name="color-scheme"]')
            ?.setAttribute('content', palette.scheme);
        } catch {
          document.documentElement.dataset.palette = 'archive';
          document.documentElement.dataset.displayFilter = 'off';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <div class="display-filter" aria-hidden="true"></div>
    <script>
      import '../scripts/editorial-interface';
    </script>
  </body>
</html>
