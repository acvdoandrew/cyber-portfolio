---
import { capabilities } from '../data/portfolio';
---
<section
  class="capabilities-section section-frame"
  id="capabilities"
  aria-labelledby="capabilities-title"
  tabindex="-1"
  data-journey-section
  data-journey-label="STACK"
  data-journey-index="02"
>
  <header class="section-intro">
    <p class="section-label">~/tools</p>
    <div>
      <h2 id="capabilities-title">usually within reach.</h2>
    </div>
  </header>

  <div class="capability-index">
    {
      capabilities.map((capability, index) => (
        <article class="capability-row">
          <p class="capability-row__number">{String(index + 1).padStart(2, '0')}</p>
          <div>
            <h3>{capability.title}</h3>
          </div>
          <ul aria-label={`${capability.title} tools`}>
            {capability.stack.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))
    }
  </div>
</section>
