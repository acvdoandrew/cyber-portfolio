---
import { capabilities } from '../data/portfolio';
---
<section
  class="capabilities-section section-frame"
  id="capabilities"
  aria-labelledby="capabilities-title"
>
  <header class="section-intro">
    <p class="section-label">02 / STACK</p>
    <div>
      <h2 id="capabilities-title">What I use to build.</h2>
      <p>Things I’ve used to build, debug, and measure real systems.</p>
    </div>
  </header>

  <div class="capability-index">
    {
      capabilities.map((capability, index) => (
        <article class="capability-row">
          <p class="capability-row__number">C_{String(index + 1).padStart(2, '0')}</p>
          <div>
            <h3>{capability.title}</h3>
            <p>{capability.summary}</p>
          </div>
          <ul aria-label={`${capability.title} tools`}>
            {capability.stack.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))
    }
  </div>
</section>
