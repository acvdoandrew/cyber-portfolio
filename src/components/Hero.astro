<section class="hero-plate" id="home" aria-labelledby="hero-title" data-recursive-figure>
  <header class="hero-plate__header">
    <p class="plate-label">Independent programmer</p>
    <p class="field-status" aria-live="polite">
      <span class="field-status__pip" aria-hidden="true"></span>
      <span data-field-status>INITIALIZING</span>
    </p>
  </header>

  <div class="hero-plate__body">
    <div class="hero-plate__copy">
      <p class="hero-kicker"><span aria-hidden="true">~</span> /home/andrew</p>
      <h1 id="hero-title">
        hi, i’m andrew.
      </h1>
      <p class="hero-lede">
        I write code to figure things out.<br />
        Mostly Rust, C++, and Python.
      </p>
      <p class="hero-note">Lately: small worlds, distributed systems, and AI.</p>
      <div class="hero-actions" aria-label="Introduction links">
        <a class="text-action" href="#work">projects/ <span aria-hidden="true">↓</span></a>
        <a class="text-action" href="#contact">
          contact.txt <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <figure class="recursive-figure">
      <p class="recursive-figure__notation sr-only" aria-label="Shader field notation">
        z ← |z| / clamp(z · z, 0.12, 4) − (0.79, 0.57)
        <span aria-hidden="true">·</span>
        I(x,y,t) = 𝟙[f(z,t) &gt; B₄(x,y)]
      </p>
      <div class="recursive-figure__stage">
        <img
          class="recursive-figure__poster"
          data-recursive-poster
          src="/assets/dither/recursive-field-poster.png"
          alt="Ordered 1-bit study of a folded recursive field forming concentric filaments."
          width="960"
          height="720"
        />
        <canvas
          class="recursive-figure__canvas"
          data-recursive-field
          role="img"
          aria-label="Live ordered 1-bit recursive field visualization"
        >
          Live ordered 1-bit recursive field visualization.
        </canvas>
      </div>
      <figcaption>
        <span>01 / recursive field</span>
        <span>move your cursor</span>
      </figcaption>
    </figure>
  </div>

  <footer class="hero-plate__footer">
    <div>
      <p class="plate-title">Boston / Cambridge</p>
      <p class="plate-taxonomy">a few things below <span aria-hidden="true">↓</span></p>
    </div>
    <p class="plate-number" aria-label="Plate 01">01</p>
  </footer>
  <script>
    import '../scripts/recursive-field';
  </script>
</section>
