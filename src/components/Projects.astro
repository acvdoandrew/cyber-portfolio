---
import ResearchFigure from './ResearchFigure.astro';
import type { ResearchFigureVariant } from './ResearchFigure.astro';
import { projects } from '../data/portfolio';
---
<section class="work-section section-frame" id="work" aria-labelledby="work-title">
  <header class="section-intro">
    <p class="section-label">01 / WORK</p>
    <div>
      <h2 id="work-title">Built, broken, still running.</h2>
      <p>The source is there. So are the rough edges.</p>
    </div>
  </header>

  <div class="work-grid">
    <div class="project-index" role="list" aria-label="Select a project preview">
      {
        projects.map((project, index) => (
          <article class="project-entry" role="listitem">
            <button
              class="project-entry__selector"
              id={`project-tab-${project.id}`}
              type="button"
              aria-controls={`project-panel-${project.id}`}
              aria-pressed={index === 0 ? 'true' : 'false'}
              data-project-select={project.id}
              data-project-title={project.title}
              data-active={index === 0 ? 'true' : 'false'}
            >
              <span class="project-entry__topline">
                <span>{String(index + 1).padStart(2, '0')} / {project.status}</span>
                <span aria-hidden="true">↗</span>
              </span>
              <span class="project-entry__heading">
                <strong>{project.title}</strong>
                <span>{project.subtitle}</span>
              </span>
              <span class="project-entry__summary">{project.summary}</span>
              <span class="project-entry__stack">
                {project.stack.map((item) => <span>{item}</span>)}
              </span>
            </button>
            <div class="project-entry__links">
              {
                project.links.length ? (
                  project.links.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer">
                      {link.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))
                ) : (
                  <span>LOCAL ONLY / NO PUBLIC LINK</span>
                )
              }
            </div>
          </article>
        ))
      }
    </div>

    <aside class="project-preview" aria-label="Selected project artwork">
      <header class="project-preview__header">
        <span>ORIGINAL PLATE / 1-BIT ENGRAVING</span>
        <span>VIEW / <strong data-preview-live-label>{projects[0].title}</strong></span>
      </header>
      <div class="project-preview__viewport">
        {
          projects.map((project, index) => (
            <div
              id={`project-panel-${project.id}`}
              role="region"
              aria-labelledby={`project-tab-${project.id}`}
              data-project-panel={project.id}
              data-active={index === 0 ? 'true' : 'false'}
              hidden={index !== 0}
            >
              <ResearchFigure
                artwork={project.artwork}
                status="STATIC"
                active={index === 0}
                variant={project.id as ResearchFigureVariant}
              />
            </div>
          ))
        }
      </div>
    </aside>
  </div>
</section>
