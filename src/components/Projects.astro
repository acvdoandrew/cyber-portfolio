---
import ProjectArtwork from './ProjectArtwork.astro';
import { projects } from '../data/portfolio';
---

<section
  class="work-section"
  id="work"
  aria-labelledby="work-title"
  tabindex="-1"
  data-journey-section
  data-journey-label="WORK"
  data-journey-index="01"
>
  <header class="section-intro project-section-intro">
    <p class="section-label">~/work</p>
    <div>
      <h2 id="work-title">a few projects.</h2>
    </div>
    <button class="study-pause" type="button" data-studies-pause aria-pressed="false" hidden>Pause studies</button>
  </header>

  <div class="project-atlas">
    {
      projects.map((project, index) => (
        <article
          class="project-plate"
          id={`project-${project.id}`}
          data-project-card
          data-project-index={String(index + 1).padStart(2, '0')}
          data-project-title={project.title}
        >
          <div class="project-entry">
            <header class="project-plate__header">
              <p>
                <span>{String(index + 1).padStart(2, '0')} / {project.subtitle}</span>
              </p>
              <div>
                <h3>{project.title}</h3>
              </div>
            </header>

            <div class="project-plate__copy">
              <p class="project-plate__summary">{project.summary}</p>

              <footer class="project-plate__footer">
                {
                  project.links.length ? (
                    project.links.map((link) => (
                      <a href={link.href} target="_blank" rel="noopener noreferrer">
                        {link.label} <span aria-hidden="true">↗</span>
                      </a>
                    ))
                  ) : (
                    <span>private repo / in progress</span>
                  )
                }
              </footer>

              <details class="project-details">
                <summary>notes<span class="sr-only"> — {project.title}</span></summary>
                <ol class="project-flow" aria-label={`${project.title} system flow`}>
                  {
                    project.flow.map((step, stepIndex) => (
                      <li>
                        <span>{String(stepIndex + 1).padStart(2, '0')}</span>
                        <div>
                          <strong>{step.label}</strong>
                          <p>{step.detail}</p>
                        </div>
                      </li>
                    ))
                  }
                </ol>
                <p class="project-stack-note" aria-label={`${project.title} stack`}>{project.stack.join(' / ')}</p>
              </details>
            </div>
          </div>

          <ProjectArtwork artwork={project.artwork} index={index} variant={project.id} />
        </article>
      ))
    }
  </div>
</section>
