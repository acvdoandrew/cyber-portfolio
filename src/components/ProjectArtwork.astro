---
import type { ArtworkSpec } from '../data/portfolio';

interface Props {
  artwork: ArtworkSpec;
  index: number;
  variant: string;
}

const { artwork, index, variant } = Astro.props;
const channel = String(index + 1).padStart(2, '0');
---

<figure class="monitor project-study" data-project-study={variant}>
  <div class="monitor__screen">
    <div class="project-study__stage" role="img" aria-label={artwork.alt}>
      <span class="project-study__poster" style={`--study-poster: url(${JSON.stringify(artwork.src)});`} aria-hidden="true"></span>
      <canvas data-study-canvas width="288" height="192" aria-hidden="true"></canvas>
    </div>
    <span class="monitor__label" aria-hidden="true">CH.{channel} // {artwork.label}</span>
    <span class="monitor__readout" aria-hidden="true">
      <span class="lamp"></span>
      <span>FR <span data-monitor-frames>0000</span></span>
    </span>
  </div>
  <figcaption>
    <span aria-hidden="true">{channel} /</span>
    <span>{artwork.caption}</span>
  </figcaption>
</figure>

<script>
  import '../scripts/project-studies/runtime';
</script>
