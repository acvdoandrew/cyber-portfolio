---
import type { ArtworkSpec } from '../data/portfolio';

interface Props {
  artwork: ArtworkSpec;
  index: number;
  variant: string;
}

const { artwork, index, variant } = Astro.props;
---

<figure class="project-artwork project-study" data-project-study={variant}>
  <div class="project-study__stage" role="img" aria-label={artwork.alt}>
    <span class="project-study__poster" style={`--study-poster: url(${JSON.stringify(artwork.src)});`} aria-hidden="true"></span>
    <canvas data-study-canvas width="288" height="192" aria-hidden="true"></canvas>
  </div>
  <figcaption><span aria-hidden="true">{String(index + 1).padStart(2, '0')} / </span>{artwork.caption}</figcaption>
</figure>

<script>
  import '../scripts/project-studies/runtime';
</script>

<style>
  .project-artwork.project-study {
    order: initial;
    min-width: 0;
    aspect-ratio: auto;
    margin: 0;
    overflow: visible;
    align-self: center;
    justify-self: center;
    width: min(100%, 30rem);
    background: transparent;
  }

  .project-study__stage {
    position: relative;
    aspect-ratio: 3 / 2;
    width: 100%;
  }

  canvas, .project-study__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--ink);
    image-rendering: pixelated;
  }

  canvas { opacity: 0; }
  [data-study-renderer='canvas'] canvas { opacity: 1; }
  [data-study-renderer='canvas'] .project-study__poster { visibility: hidden; }

  .project-study__poster {
    background: var(--ink);
    mask: var(--study-poster) center / contain no-repeat;
    -webkit-mask: var(--study-poster) center / contain no-repeat;
  }

  figcaption {
    margin-top: -0.25rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0;
    line-height: 1.6;
    text-align: center;
  }

  figcaption > span { color: var(--accent-readable); }
</style>
