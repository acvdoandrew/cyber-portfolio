---
import { ENTITY_HEIGHT, ENTITY_WIDTH } from '../scripts/entity/forms';
---
<figure class="entity" data-intelligence>
  <div
    class="entity__stage"
    data-intelligence-stage
    role="img"
    aria-label="A figure made of loose bytes leaning over the contact terminal. It keeps rebuilding itself, trying out a sign, then an outline, then a body, as if searching for a shape a person would recognize."
  >
    <span class="entity__poster" aria-hidden="true"></span>
    <canvas class="entity__canvas" data-intelligence-canvas width={ENTITY_WIDTH} height={ENTITY_HEIGHT} aria-hidden="true"></canvas>
    <div class="entity__tags" aria-hidden="true">
      <span class="entity-tag entity-tag--head" data-entity-tag="head"><b data-tag-label>HEAD</b> <span data-tag-value>0.00</span></span>
      <span class="entity-tag entity-tag--hand" data-entity-tag="left"><b data-tag-label>HAND.L</b> <span data-tag-value>0.00</span></span>
      <span class="entity-tag entity-tag--hand" data-entity-tag="right"><b data-tag-label>HAND.R</b> <span data-tag-value>0.00</span></span>
    </div>
  </div>
  <figcaption class="sr-only">A resident process on the contact channel. It follows your cursor and the typing in the terminal.</figcaption>
</figure>

<script>
  import '../scripts/contact-intelligence';
</script>
