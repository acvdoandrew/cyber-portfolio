---
import { contactLinks } from '../data/portfolio';

const labels = { email: 'mail', github: 'code', x: 'x' };
const command = 'cat contact.txt';
const greeting = 'hey. you found me.';
const signoff = '# say hi. strange links welcome.';
---

<div class="contact-terminal" data-contact-terminal>
  <header class="terminal-bar">
    <span class="terminal-filename">contact.txt</span>
  </header>
  <div class="terminal-content">
    <p class="terminal-command">
      <span class="terminal-prompt" aria-hidden="true">andrew ~ $ </span><span class="terminal-command-text" data-type-line data-type-length={command.length}>{command}</span>
    </p>
    <p class="terminal-line terminal-greeting" data-type-line data-type-length={greeting.length}>{greeting}</p>
    <div class="terminal-addresses" aria-label="Contact methods">
      {contactLinks.map((contact) => (
        <p class="terminal-line terminal-address" data-type-line data-type-length={6 + contact.value.length}>
          <span class="terminal-key" aria-hidden="true">{labels[contact.id]}</span><a
            href={contact.href}
            target={contact.external ? '_blank' : undefined}
            rel={contact.external ? 'noopener noreferrer' : undefined}
            aria-label={`${contact.label}: ${contact.value}`}
          >{contact.value}</a>
        </p>
      ))}
    </div>
    <p class="terminal-line terminal-signoff" data-type-line data-type-length={signoff.length}>{signoff}</p>
    <p class="terminal-ready" aria-hidden="true"><span class="terminal-prompt">andrew ~ $ </span><span class="terminal-caret"></span></p>
  </div>
    <div class="terminal-controls">
      <button type="button" data-terminal-skip hidden>skip</button>
      <button type="button" data-intelligence-pause aria-label="Pause intelligence animation" aria-pressed="false" hidden>pause art</button>
    </div>

</div>

<script>
  import '../scripts/contact-terminal';
</script>

<style>
  .contact-terminal {
    --paper: color-mix(in srgb, var(--frame-field) 60%, #000);
    --ink: var(--frame-ink);
    --muted: var(--frame-muted);
    --rule: var(--frame-rule);
    --accent-readable: var(--frame-accent);
    position: relative;
    z-index: 2;
    width: 88%;
    margin: 44.3% auto 0;
    border: 1px solid var(--frame-rule-strong);
    border-radius: 3px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.85;
    box-shadow: 0 1.5rem 4rem #00000020;
  }

  .terminal-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 40px;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-size: 12px;
  }

  .terminal-filename { position: relative; z-index: 5; }
  .terminal-controls { position: absolute; z-index: 5; right: 1.25rem; bottom: 1rem; display: flex; align-items: center; gap: 1rem; color: var(--muted); font-size: 12px; }
  .terminal-controls button {
    min-height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .terminal-controls button:hover { color: var(--ink); }

  .terminal-content { padding: 1.3rem 1.5rem 1.5rem; }
  .terminal-content p { margin: 0; }
  .terminal-content .terminal-greeting { margin-top: 1rem; }
  .terminal-addresses { margin-top: 1rem; }
  .terminal-content .terminal-signoff { margin-top: 1rem; color: var(--muted); }
  .terminal-content .terminal-ready { margin-top: 0.8rem; }
  .terminal-prompt { color: var(--accent-readable); }
  .terminal-key { display: inline-block; width: 6ch; color: var(--muted); }
  .terminal-address a { color: var(--ink); text-decoration: none; }
  .terminal-address a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .terminal-command-text { display: inline-block; vertical-align: bottom; }
  .terminal-line, .terminal-command { white-space: nowrap; }

  [data-type-line] { position: relative; }
  [data-typing='true'] [data-type-line] {
    clip-path: inset(0 max(0px, calc(100% - (var(--typed-chars, 0) + var(--type-caret, 0)) * 1ch)) 0 0);
  }
  [data-typing='true'] [data-type-active='true'] { --type-caret: 0.7; }
  [data-typing='true'] [data-type-active='true']::after {
    position: absolute;
    top: 0.35em;
    left: calc(var(--typed-chars, 0) * 1ch);
    width: 0.6ch;
    height: 1em;
    background: currentColor;
    content: '';
  }
  [data-typing='true'] .terminal-ready { visibility: hidden; }

  .terminal-caret {
    display: inline-block;
    width: 0.6ch;
    height: 1em;
    vertical-align: -0.12em;
    background: currentColor;
    animation: terminal-blink 1.15s steps(1, end) infinite;
  }
  @keyframes terminal-blink { 0%, 50% { opacity: 1; } 51%, 100% { opacity: 0; } }

  @media (max-width: 640px) {
    .contact-terminal { width: 100%; font-size: 14px; line-height: 1.8; }
    .terminal-bar { padding-inline: 0.9rem; gap: 0.5rem; }
    .terminal-controls { right: 1rem; bottom: 0.75rem; gap: 0.65rem; }
    .terminal-content { padding: 1rem; }
    .terminal-signoff { font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-caret { animation: none; }
    [data-typing='true'] [data-type-line] { clip-path: none; }
    [data-typing='true'] .terminal-ready { visibility: visible; }
  }
</style>
