---
// The between-channels card: a beat of black, the channel's name, and one
// line of text. Purely visual; the router drives it.
---
<div class="cut" data-cut aria-hidden="true">
  <span class="cut__ghost" data-cut-ghost>00</span>
  <div class="cut__card">
    <span class="cut__kicker">channel <b data-cut-number>00</b></span>
    <span class="cut__title" data-cut-title>home</span>
    <span class="cut__line" data-cut-line>hello, operator</span>
  </div>
</div>
