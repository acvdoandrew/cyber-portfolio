---
import ContactIntelligence from './ContactIntelligence.astro';
import ContactTerminal from './ContactTerminal.astro';
import ReviewPanel from './ReviewPanel.astro';
---
<section
  class="view view--contact"
  id="contact"
  aria-labelledby="contact-title"
  data-view="contact"
>
  <h2 id="contact-title" class="sr-only" tabindex="-1">Contact</h2>
  <div class="contact__stage">
    <div class="contact-scene" data-contact-scene>
      <ContactIntelligence />
      <ContactTerminal />
    </div>
  </div>
  <ReviewPanel />
</section>
