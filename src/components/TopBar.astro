---
const navItems = [
  { label: 'work', href: '#work' },
  { label: 'tools', href: '#capabilities' },
  { label: 'contact', href: '#contact' },
];
---
<header class="masthead" data-masthead>
  <div class="masthead__inner">
    <a class="wordmark" href="#home" aria-label="Andrew, return to the introduction">
      <span class="wordmark__name">andrew<span aria-hidden="true">_</span></span>
    </a>

    <nav class="masthead__nav" id="primary-navigation" aria-label="Primary navigation">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="masthead__controls">
      <button
        class="display-mode-toggle"
        type="button"
        data-display-filter-toggle
        aria-pressed="false"
        aria-label="Enable CRT display filter"
      >
        <span class="display-mode-toggle__pip" aria-hidden="true"></span>
        <span>CRT</span>
        <span class="sr-only" data-display-filter-announcement>
          CRT display filter disabled. Activate to enable.
        </span>
      </button>

      <button
        class="palette-cycle"
        type="button"
        data-palette-cycle
        aria-label="Current palette archive. Activate for carbon."
      >
        <span class="palette-cycle__glyph" aria-hidden="true">✳</span>
        <span class="palette-cycle__label" data-palette-current>archive</span>
        <span class="sr-only" data-palette-announcement>
          Current palette archive. Activate for carbon.
        </span>
      </button>

      <button
        class="menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="primary-navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
